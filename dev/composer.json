{
    "name": "project/winter-dev",
    "description": "The winter-kernel playground: the repository itself, installed as a symlink",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Main\\": "main/"
        }
    },
    "require": {
        "php": ">=8.4",
        "flytachi/winter-kernel": "*@dev",
        "flytachi/winter-ppa": "^1.2",
        "flytachi/winter-redis": "^1.1",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "swoole/ide-helper": "^6.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
