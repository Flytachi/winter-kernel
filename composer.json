{
    "name": "flytachi/winter-kernel",
    "description": "Winter framework kernel",
    "keywords": ["Winter Kernel", "winter kernel", "framework kernel", "kernel"],
    "type": "library",
    "license": "MIT",
    "homepage": "https://winterframe.net",
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-detail": "vendor/bin/phpunit --testdox"
    },
    "support": {
        "source": "https://github.com/flytachi/winter-kernel",
        "docs": "https://winterframe.net/docs"
    },
    "autoload": {
        "psr-4": {
            "Flytachi\\Winter\\Console\\": "console/",
            "Flytachi\\Winter\\K2\\": "src/"
        },
        "files": [
            "function/dependencies.php"
        ]
    },
    "require": {
        "php": ">=8.3",
        "flytachi/winter-base": "^3.0",
        "flytachi/winter-logger": "^1.0",
        "flytachi/winter-thread": "^1.0",
        "flytachi/winter-cdo": "^3.0",
        "flytachi/winter-cache": "^1.0",
        "flytachi/file-store": "^1.0",
        "vlucas/phpdotenv": "^5.6",

        "ext-pcntl": "*",
        "ext-posix": "*"
    },
    "suggest": {
        "ext-simplexml": "Required for XML file operations (K2\\File\\XML)",
        "ext-swoole": "Required for coroutine-based connection pooling (Swoole mode)",
        "ext-shmop": "Recommended for Swoole mode — enables PAYLOAD_SHM in Thread dispatch, avoiding fd conflicts with proc_open (fallback: PAYLOAD_PIPE)"
    },
    "autoload-dev": {
        "psr-4": {
            "Flytachi\\Winter\\Kernel\\Tests\\": "tests",
            "Flytachi\\Winter\\Kernel\\Dev\\Main\\": "dev/main"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "@stable",
        "squizlabs/php_codesniffer": "@stable",
        "swoole/ide-helper": "^6.0",
        "monolog/monolog": "@stable"
    },
    "bin": ["wKernelExecutor"],
    "authors": [
        {
            "name": "Flytachi",
            "email": "jasur.rakhmatov03@gmail.com"
        }
    ]
}
