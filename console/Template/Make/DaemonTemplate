<?php

namespace __namespace__;

use Flytachi\Winter\Kernel\Process\Stereotype\Daemon;

final class __className__ extends Daemon
{
    /** Baseline fleet size — replicas the master keeps alive. */
    protected int $replicas = 3;

    /**
     * The worker body — the daemon is also the worker, so this runs in every
     * replica. (Alternatively drop this and set `$workerClass` to a Process class.)
     */
    protected function workerRun(): void
    {
        while ($this->isRunning()) {
            $this->markBusy();
            // ... work ...
            $this->markIdle();

            $this->sleep(1.0);
        }
    }
}
