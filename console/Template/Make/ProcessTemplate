<?php

namespace __namespace__;

use Flytachi\Winter\K2\Process\Process;

final class __className__ extends Process
{
    /**
     * The process body — loop while the process is running. A stop signal flips
     * isRunning() to false; an idle sleep() is interrupted at once.
     */
    public function run(): void
    {
        while ($this->isRunning()) {
            $this->markBusy();
            // ... work ...
            $this->markIdle();

            $this->sleep(1.0);
        }
    }
}
